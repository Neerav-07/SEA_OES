# Kshamata ML Intelligence Service Configuration

# Service Network Settings
ML_PORT=8000

# Model & Embedding Pipeline Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CONFIDENCE_THRESHOLD=0.75
MAX_RECOMMENDATIONS=5

# LLM & Generation Pipeline Settings (Optional)
# Options: deterministic | openai | gemini
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
GEMINI_API_KEY=
